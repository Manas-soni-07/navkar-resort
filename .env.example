# General Monorepo Settings
NODE_ENV=development

# Backend API Base URL
NEXT_PUBLIC_API_URL=http://localhost:3000

# Mobile Application (Public Expo configuration)
EXPO_PUBLIC_API_URL=http://localhost:3000/api
