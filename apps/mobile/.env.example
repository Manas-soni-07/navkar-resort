# ========================================================
# ResortOS Mobile - Public Environment Template
# Copy to apps/mobile/.env for local app development
# NEVER put private server secrets in mobile app configs!
# Only EXPO_PUBLIC_* variables are bundled into the app.
# ========================================================

# Base API endpoint for the backend
# Use your computer's local Wi-Fi IP address (e.g., http://192.168.1.100:3000/api)
# when testing on physical Android devices running Expo Go.
EXPO_PUBLIC_API_URL=http://localhost:3000/api
