{
  "expo": {
    "name": "ResortOS",
    "slug": "resortos",
    "version": "1.4.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "resortos",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8F9FA"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.resortos.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F2942",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.resortos.app",
      "versionCode": 6
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": false
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ResortOS needs access to your photos to attach guest ID documents and expense receipts.",
          "cameraPermission": "ResortOS needs the camera to photograph guest ID documents and expense receipts."
        }
      ]
    ],
    "description": "Hotel & resort management for The Villa and Navkar Palace"
  }
}
