{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "build": "prisma generate && next build",
    "start": "next start -p 3000 -H 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "prisma:generate": "prisma generate",
    "db:push": "node --env-file=.env.local scripts/db-push-local.mjs",
    "db:seed": "node --env-file=.env.local prisma/seed.mjs",
    "db:check:tidb": "node --env-file=.env.tidb.local scripts/check-tidb-schema.mjs",
    "db:backup": "node --env-file=.env.local scripts/backup-db.mjs",
    "user:set-password": "node --env-file=.env.local scripts/set-password.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "@resortos/shared": "workspace:*",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.17",
    "mysql2": "^3.24.6",
    "next": "^15.1.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "xlsx": "0.18.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "eslint": "^9.20.1",
    "eslint-config-next": "^15.1.7",
    "prisma": "^6.4.1",
    "typescript": "^5.7.2"
  }
}
