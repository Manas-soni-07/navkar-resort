// ========================================================
// ResortOS Enterprise Prisma Schema
// Target Database: TiDB Cloud Serverless (MySQL 8.0 Protocol)
// Architecture: Multi-tenant, distributed SQL optimized
// ========================================================

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

generator client {
  provider = "prisma-client-js"
}

// ========================================================
// ENUMS
// ========================================================

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  RECEPTIONIST
  STAFF
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum HotelStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}

enum RoomType {
  STANDARD
  DELUXE
  EXECUTIVE_SUITE
  PRESIDENTIAL_SUITE
  VILLA
  PENTHOUSE
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  DIRTY
  CLEANING
  INSPECTION
  MAINTENANCE
  BLOCKED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

enum StayStatus {
  ACTIVE
  COMPLETED
  EXTENDED
  EARLY_CHECKOUT
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  DEBIT_CARD
  BANK_TRANSFER
  UPI
  ONLINE
  FOLIO_CHARGE
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOID
  PARTIALLY_PAID
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LATE
  ON_LEAVE
}

enum AdvanceStatus {
  PENDING
  APPROVED
  REJECTED
  DEDUCTED
}

enum SalaryStatus {
  PENDING
  PROCESSED
  PAID
  CANCELLED
}

enum ExpenseCategory {
  UTILITIES
  MAINTENANCE
  SUPPLIES
  FOOD_BEVERAGE
  MARKETING
  PAYROLL
  TAXES
  MISCELLANEOUS
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  STATUS_CHANGE
  PAYMENT_PROCESSED
  VOID
}

// ========================================================
// SYSTEM & HEALTH (Backwards compatibility)
// ========================================================

model SystemHealth {
  id        String   @id @default(cuid())
  service   String
  status    String
  timestamp DateTime @default(now())

  @@map("system_health")
}

// ========================================================
// 1. ORGANIZATION (Multi-tenant Root)
// ========================================================

model Organization {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  taxNumber    String?
  contactEmail String
  contactPhone String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  hotels Hotel[]
  users  User[]

  @@map("organizations")
}

// ========================================================
// 2. HOTEL (Property Entity)
// ========================================================

model Hotel {
  id             String      @id @default(cuid())
  organizationId String
  name           String
  slug           String
  code           String      @unique
  status         HotelStatus @default(ACTIVE)
  starRating     Int?        @default(4)
  address        String
  city           String
  state          String?
  country        String
  postalCode     String?
  contactPhone   String
  contactEmail   String
  receptionPhone String?
  currency       String      @default("USD")
  timezone       String      @default("UTC")
  checkInTime    String      @default("14:00")
  checkOutTime   String      @default("11:00")
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id])
  users              User[]
  managerAssignments ManagerAssignment[]
  rooms              Room[]
  staff              Staff[]
  attendances        Attendance[]
  staffAdvances      StaffAdvance[]
  salaryPayments     SalaryPayment[]
  bookings           Booking[]
  stays              Stay[]
  payments           Payment[]
  invoices           Invoice[]
  expenses           Expense[]
  auditLogs          AuditLog[]

  @@index([organizationId])
  @@index([slug])
  @@index([status])
  @@map("hotels")
}

// ========================================================
// 3. USER (System Access Accounts)
// ========================================================

model User {
  id             String     @id @default(cuid())
  organizationId String
  hotelId        String?
  email          String     @unique
  passwordHash   String
  fullName       String
  phone          String?
  role           UserRole   @default(MANAGER)
  status         UserStatus @default(ACTIVE)
  lastLoginAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id])
  hotel              Hotel?              @relation(fields: [hotelId], references: [id])
  managerAssignments ManagerAssignment[]
  createdBookings    Booking[]           @relation("BookedByUser")
  processedPayments  Payment[]           @relation("PaymentProcessedBy")
  auditLogs          AuditLog[]

  @@index([organizationId])
  @@index([hotelId])
  @@index([role])
  @@index([status])
  @@map("users")
}

// ========================================================
// 4. MANAGER ASSIGNMENT (Property Governance)
// ========================================================

model ManagerAssignment {
  id         String   @id @default(cuid())
  userId     String
  hotelId    String
  isPrimary  Boolean  @default(true)
  assignedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  hotel Hotel @relation(fields: [hotelId], references: [id])

  @@unique([userId, hotelId])
  @@index([hotelId])
  @@map("manager_assignments")
}

// ========================================================
// 5. STAFF (Hotel Personnel)
// ========================================================

model Staff {
  id              String    @id @default(cuid())
  hotelId         String
  employeeCode    String
  firstName       String
  lastName        String
  email           String?
  phone           String
  department      String
  designation     String
  baseSalary      Decimal   @db.Decimal(12, 2)
  hourlyRate      Decimal?  @db.Decimal(10, 2)
  joiningDate     DateTime
  terminationDate DateTime?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  hotel          Hotel           @relation(fields: [hotelId], references: [id])
  attendances    Attendance[]
  staffAdvances  StaffAdvance[]
  salaryPayments SalaryPayment[]

  @@unique([hotelId, employeeCode])
  @@index([hotelId])
  @@index([department])
  @@index([isActive])
  @@map("staff")
}

// ========================================================
// 6. ATTENDANCE (Staff Duty Log)
// ========================================================

model Attendance {
  id        String           @id @default(cuid())
  staffId   String
  hotelId   String
  date      DateTime         @db.Date
  checkIn   DateTime?
  checkOut  DateTime?
  status    AttendanceStatus @default(PRESENT)
  notes     String?
  createdAt DateTime         @default(now())

  staff Staff @relation(fields: [staffId], references: [id])
  hotel Hotel @relation(fields: [hotelId], references: [id])

  @@unique([staffId, date])
  @@index([hotelId])
  @@index([date])
  @@index([status])
  @@map("attendances")
}

// ========================================================
// 7. STAFF ADVANCE (Salary Advances / Loans)
// ========================================================

model StaffAdvance {
  id           String        @id @default(cuid())
  staffId      String
  hotelId      String
  amount       Decimal       @db.Decimal(10, 2)
  repaidAmount Decimal       @default(0) @db.Decimal(10, 2)
  status       AdvanceStatus @default(PENDING)
  requestDate  DateTime      @default(now())
  approvedDate DateTime?
  notes        String?

  staff Staff @relation(fields: [staffId], references: [id])
  hotel Hotel @relation(fields: [hotelId], references: [id])

  @@index([hotelId])
  @@index([staffId])
  @@index([status])
  @@map("staff_advances")
}

// ========================================================
// 8. SALARY PAYMENT (Monthly Payroll Settlements)
// ========================================================

model SalaryPayment {
  id            String         @id @default(cuid())
  staffId       String
  hotelId       String
  month         Int
  year          Int
  baseSalary    Decimal        @db.Decimal(10, 2)
  allowances    Decimal        @default(0) @db.Decimal(10, 2)
  deductions    Decimal        @default(0) @db.Decimal(10, 2)
  netAmount     Decimal        @db.Decimal(10, 2)
  status        SalaryStatus   @default(PENDING)
  paidAt        DateTime?
  paymentMethod PaymentMethod?
  reference     String?

  staff Staff @relation(fields: [staffId], references: [id])
  hotel Hotel @relation(fields: [hotelId], references: [id])

  @@unique([staffId, month, year])
  @@index([hotelId])
  @@index([year, month])
  @@index([status])
  @@map("salary_payments")
}

// ========================================================
// 9. ROOM (Hotel Inventory Units)
// ========================================================

model Room {
  id                String     @id @default(cuid())
  hotelId           String
  roomNumber        String
  floor             Int
  type              RoomType   @default(STANDARD)
  status            RoomStatus @default(AVAILABLE)
  basePricePerNight Decimal    @db.Decimal(10, 2)
  maxOccupancy      Int        @default(2)
  bedCount          Int        @default(1)
  hasBalcony        Boolean    @default(false)
  hasOceanView      Boolean    @default(false)
  description       String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  hotel        Hotel         @relation(fields: [hotelId], references: [id])
  bookingRooms BookingRoom[]
  stays        Stay[]

  @@unique([hotelId, roomNumber])
  @@index([hotelId])
  @@index([type])
  @@index([status])
  @@map("rooms")
}

// ========================================================
// 10. GUEST (Customer Identity)
// ========================================================

model Guest {
  id              String   @id @default(cuid())
  organizationId  String
  firstName       String
  lastName        String
  email           String?
  phone           String?
  idType          String?
  idNumber        String?
  nationality     String?
  address         String?
  city            String?
  country         String?
  vipStatus       Boolean  @default(false)
  specialRequests String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  bookings   Booking[]
  stayGuests StayGuest[]

  @@index([organizationId])
  @@index([email])
  @@index([phone])
  @@index([idNumber])
  @@map("guests")
}

// ========================================================
// 11. BOOKING (Reservations)
// ========================================================

model Booking {
  id               String        @id @default(cuid())
  hotelId          String
  guestId          String
  createdById      String?
  bookingReference String        @unique
  status           BookingStatus @default(PENDING)
  checkInDate      DateTime
  checkOutDate     DateTime
  totalGuests      Int           @default(1)
  totalRooms       Int           @default(1)
  totalAmount      Decimal       @db.Decimal(12, 2)
  taxAmount        Decimal       @default(0) @db.Decimal(10, 2)
  discountAmount   Decimal       @default(0) @db.Decimal(10, 2)
  notes            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  hotel        Hotel                @relation(fields: [hotelId], references: [id])
  guest        Guest                @relation(fields: [guestId], references: [id])
  createdBy    User?                @relation("BookedByUser", fields: [createdById], references: [id])
  bookingRooms BookingRoom[]
  extraCharges BookingExtraCharge[]
  stay         Stay?
  invoices     Invoice[]
  payments     Payment[]

  @@index([hotelId])
  @@index([guestId])
  @@index([createdById])
  @@index([status])
  @@index([checkInDate])
  @@index([checkOutDate])
  @@map("bookings")
}

// ========================================================
// 12. BOOKING ROOM (Room Allocation in Booking)
// ========================================================

model BookingRoom {
  id          String  @id @default(cuid())
  bookingId   String
  roomId      String
  nightlyRate Decimal @db.Decimal(10, 2)

  booking Booking @relation(fields: [bookingId], references: [id])
  room    Room    @relation(fields: [roomId], references: [id])

  @@unique([bookingId, roomId])
  @@index([roomId])
  @@map("booking_rooms")
}

// ========================================================
// 13. BOOKING EXTRA CHARGE (Amenities & Incidentals)
// ========================================================

model BookingExtraCharge {
  id        String   @id @default(cuid())
  bookingId String
  title     String
  category  String
  amount    Decimal  @db.Decimal(10, 2)
  quantity  Int      @default(1)
  chargedAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([bookingId])
  @@map("booking_extra_charges")
}

// ========================================================
// 14. STAY (Actual Check-in to Check-out Period)
// ========================================================

model Stay {
  id             String     @id @default(cuid())
  hotelId        String
  bookingId      String     @unique
  roomId         String
  status         StayStatus @default(ACTIVE)
  actualCheckIn  DateTime   @default(now())
  actualCheckOut DateTime?
  keyCardCount   Int        @default(1)
  remarks        String?

  hotel      Hotel       @relation(fields: [hotelId], references: [id])
  booking    Booking     @relation(fields: [bookingId], references: [id])
  room       Room        @relation(fields: [roomId], references: [id])
  stayGuests StayGuest[]

  @@index([hotelId])
  @@index([roomId])
  @@index([status])
  @@map("stays")
}

// ========================================================
// 15. STAY GUEST (Residents in the Room)
// ========================================================

model StayGuest {
  id             String  @id @default(cuid())
  stayId         String
  guestId        String
  isPrimaryGuest Boolean @default(false)

  stay  Stay  @relation(fields: [stayId], references: [id])
  guest Guest @relation(fields: [guestId], references: [id])

  @@unique([stayId, guestId])
  @@index([guestId])
  @@map("stay_guests")
}

// ========================================================
// 16. PAYMENT (Financial Transactions)
// ========================================================

model Payment {
  id                   String        @id @default(cuid())
  hotelId              String
  bookingId            String?
  invoiceId            String?
  processedById        String?
  transactionReference String        @unique
  amount               Decimal       @db.Decimal(12, 2)
  currency             String        @default("USD")
  paymentMethod        PaymentMethod @default(CASH)
  status               PaymentStatus @default(COMPLETED)
  gatewayResponse      String?       @db.Text
  paidAt               DateTime      @default(now())

  hotel       Hotel    @relation(fields: [hotelId], references: [id])
  booking     Booking? @relation(fields: [bookingId], references: [id])
  invoice     Invoice? @relation(fields: [invoiceId], references: [id])
  processedBy User?    @relation("PaymentProcessedBy", fields: [processedById], references: [id])

  @@index([hotelId])
  @@index([bookingId])
  @@index([invoiceId])
  @@index([processedById])
  @@index([status])
  @@index([paidAt])
  @@map("payments")
}

// ========================================================
// 17. INVOICE (Formal Billing Folios)
// ========================================================

model Invoice {
  id             String        @id @default(cuid())
  hotelId        String
  bookingId      String
  invoiceNumber  String        @unique
  subtotal       Decimal       @db.Decimal(12, 2)
  taxAmount      Decimal       @db.Decimal(10, 2)
  discountAmount Decimal       @default(0) @db.Decimal(10, 2)
  totalAmount    Decimal       @db.Decimal(12, 2)
  paidAmount     Decimal       @default(0) @db.Decimal(12, 2)
  status         InvoiceStatus @default(DRAFT)
  dueDate        DateTime?
  issuedAt       DateTime      @default(now())

  hotel    Hotel     @relation(fields: [hotelId], references: [id])
  booking  Booking   @relation(fields: [bookingId], references: [id])
  payments Payment[]

  @@index([hotelId])
  @@index([bookingId])
  @@index([status])
  @@map("invoices")
}

// ========================================================
// 18. EXPENSE (Operational Expenditures)
// ========================================================

model Expense {
  id            String          @id @default(cuid())
  hotelId       String
  category      ExpenseCategory @default(SUPPLIES)
  title         String
  amount        Decimal         @db.Decimal(12, 2)
  paymentMethod PaymentMethod   @default(CASH)
  reference     String?
  receiptUrl    String?
  incurredAt    DateTime
  createdAt     DateTime        @default(now())

  hotel Hotel @relation(fields: [hotelId], references: [id])

  @@index([hotelId])
  @@index([category])
  @@index([incurredAt])
  @@map("expenses")
}

// ========================================================
// 19. AUDIT LOG (Immutable Regulatory Compliance)
// ========================================================

model AuditLog {
  id         String      @id @default(cuid())
  hotelId    String?
  userId     String?
  action     AuditAction
  entityType String
  entityId   String
  ipAddress  String?
  userAgent  String?
  details    String?     @db.Text
  createdAt  DateTime    @default(now())

  hotel Hotel? @relation(fields: [hotelId], references: [id])
  user  User?  @relation(fields: [userId], references: [id])

  @@index([hotelId])
  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
  @@map("audit_logs")
}
