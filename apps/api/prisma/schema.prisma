// ========================================================
// ResortOS Prisma Schema
// Target Database: TiDB Cloud Serverless (MySQL 8.0 protocol)
//
// Aligned with the LIVE TiDB `resortos` database on 2026-11-20 (see docs/AUDIT_REPORT.md §5):
// every table, column, type and index name below exists in TiDB, so
// `prisma migrate diff` against TiDB is empty. Columns marked "legacy" were
// created by an earlier version of the app and still hold data; keep them
// until their data has been migrated. NEVER run `db push` against TiDB.
// ========================================================

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

generator client {
  provider = "prisma-client-js"
}

// ========================================================
// ENUMS
// ========================================================

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  RECEPTIONIST
  STAFF
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum HotelStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}

enum RoomType {
  STANDARD
  DELUXE
  EXECUTIVE_SUITE
  PRESIDENTIAL_SUITE
  VILLA
  PENTHOUSE
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  DIRTY
  CLEANING
  INSPECTION
  MAINTENANCE
  BLOCKED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

enum StayStatus {
  ACTIVE
  COMPLETED
  EXTENDED
  EARLY_CHECKOUT
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  DEBIT_CARD
  BANK_TRANSFER
  UPI
  ONLINE
  FOLIO_CHARGE
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOID
  PARTIALLY_PAID
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LATE
  ON_LEAVE
}

enum AdvanceStatus {
  PENDING
  APPROVED
  REJECTED
  DEDUCTED
}

enum SalaryStatus {
  PENDING
  PROCESSED
  PAID
  CANCELLED
}

enum ExpenseCategory {
  UTILITIES
  MAINTENANCE
  SUPPLIES
  FOOD_BEVERAGE
  MARKETING
  PAYROLL
  TAXES
  MISCELLANEOUS
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  STATUS_CHANGE
  PAYMENT_PROCESSED
  VOID
}

// Legacy module enums (lower-case values exist in TiDB data)
enum BanquetEventStatus {
  confirmed
  in_progress
  completed
  cancelled
}

enum ConciergeBookingStatus {
  scheduled
  in_transit
  completed
  cancelled
}

enum DiningOrderStatus {
  received
  in_kitchen
  out_for_delivery
  delivered
}

enum HousekeepingPriority {
  urgent
  high
  normal
}

enum HousekeepingTicketStatus {
  pending
  in_progress
  completed
}

enum SpaBookingStatus {
  scheduled
  in_session
  completed
  cancelled
}

// ========================================================
// SYSTEM & HEALTH
// ========================================================

model SystemHealth {
  id        String   @id @default(cuid())
  service   String
  status    String
  timestamp DateTime @default(now())

  @@map("system_health")
}

// ========================================================
// 1. ORGANIZATION (Multi-tenant Root)
// ========================================================

model Organization {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique(map: "slug")
  taxNumber    String?
  contactEmail String
  contactPhone String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  hotels Hotel[]
  users  User[]

  @@map("organizations")
}

// ========================================================
// 2. HOTEL (Property Entity)
// ========================================================

model Hotel {
  id             String      @id @default(cuid())
  organizationId String
  name           String
  slug           String
  code           String      @unique(map: "code")
  status         HotelStatus @default(ACTIVE)
  starRating     Int?        @default(4)
  address        String
  city           String
  state          String?
  country        String
  postalCode     String?
  contactPhone   String
  contactEmail   String
  receptionPhone String?
  currency       String      @default("USD")
  timezone       String      @default("UTC")
  checkInTime    String      @default("14:00")
  checkOutTime   String      @default("11:00")
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @default(now()) @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id])
  users              User[]
  managerAssignments ManagerAssignment[]
  rooms              Room[]
  staff              Staff[]
  attendances        Attendance[]
  staffAdvances      StaffAdvance[]
  salaryPayments     SalaryPayment[]
  bookings           Booking[]
  stays              Stay[]
  payments           Payment[]
  invoices           Invoice[]
  expenses           Expense[]
  auditLogs          AuditLog[]

  @@index([organizationId], map: "idx_hotels_org")
  @@index([slug], map: "idx_hotels_slug")
  @@index([status], map: "idx_hotels_status")
  @@map("hotels")
}

// ========================================================
// 3. USER (System Access Accounts)
// ========================================================

model User {
  id             String     @id @default(cuid())
  organizationId String
  hotelId        String?
  email          String     @unique(map: "email")
  passwordHash   String
  fullName       String
  phone          String?
  role           UserRole   @default(MANAGER)
  status         UserStatus @default(ACTIVE)
  lastLoginAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @default(now()) @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id])
  hotel              Hotel?              @relation(fields: [hotelId], references: [id])
  managerAssignments ManagerAssignment[]
  createdBookings    Booking[]           @relation("BookedByUser")
  processedPayments  Payment[]           @relation("PaymentProcessedBy")
  auditLogs          AuditLog[]

  @@index([organizationId], map: "idx_users_org")
  @@index([hotelId], map: "idx_users_hotel")
  @@index([role], map: "idx_users_role")
  @@index([status], map: "idx_users_status")
  @@map("users")
}

// ========================================================
// 4. MANAGER ASSIGNMENT (Property Governance)
// ========================================================

model ManagerAssignment {
  id         String   @id @default(cuid())
  userId     String
  hotelId    String
  isPrimary  Boolean  @default(true)
  assignedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  hotel Hotel @relation(fields: [hotelId], references: [id])

  @@unique([userId, hotelId], map: "uq_manager_hotel")
  @@index([hotelId], map: "idx_manager_hotel")
  @@map("manager_assignments")
}

// ========================================================
// 5. STAFF (Hotel Personnel)
// ========================================================

model Staff {
  id              String    @id @default(cuid())
  hotelId         String
  employeeCode    String
  firstName       String
  lastName        String
  email           String?
  phone           String
  department      String
  designation     String
  baseSalary      Decimal   @db.Decimal(12, 2)
  hourlyRate      Decimal?  @db.Decimal(10, 2)
  joiningDate     DateTime
  terminationDate DateTime?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt
  // legacy
  fullName        String?
  role            String?   @db.VarChar(100)
  monthlySalary   Decimal?  @default(0) @db.Decimal(10, 2)
  joinDate        DateTime? @db.Date
  status          String?   @default("ACTIVE") @db.VarChar(50)
  shift           String?   @default("Morning") @db.VarChar(50)
  checkInTime     String?   @db.VarChar(50)

  hotel          Hotel           @relation(fields: [hotelId], references: [id])
  attendances    Attendance[]
  staffAdvances  StaffAdvance[]
  salaryPayments SalaryPayment[]

  @@unique([hotelId, employeeCode], map: "uq_staff_hotel_emp")
  @@index([hotelId], map: "idx_staff_hotel")
  @@index([department], map: "idx_staff_dept")
  @@index([isActive], map: "idx_staff_active")
  @@map("staff")
}

// ========================================================
// 6. ATTENDANCE (Staff Duty Log)
// ========================================================

model Attendance {
  id          String           @id @default(cuid())
  staffId     String
  hotelId     String
  date        DateTime         @db.Date
  checkIn     DateTime?
  checkOut    DateTime?
  status      AttendanceStatus @default(PRESENT)
  notes       String?          @db.Text
  createdAt   DateTime         @default(now())
  // legacy
  checkInTime String?          @db.VarChar(50)
  staffName   String?
  role        String?          @db.VarChar(100)

  staff Staff @relation(fields: [staffId], references: [id])
  hotel Hotel @relation(fields: [hotelId], references: [id])

  @@unique([staffId, date], map: "uq_staff_date")
  @@index([hotelId], map: "idx_att_hotel")
  @@index([date], map: "idx_att_date")
  @@index([status], map: "idx_att_status")
  @@map("attendances")
}

// ========================================================
// 7. STAFF ADVANCE (Salary Advances / Loans)
// ========================================================

model StaffAdvance {
  id            String        @id @default(cuid())
  staffId       String
  hotelId       String
  amount        Decimal       @db.Decimal(10, 2)
  repaidAmount  Decimal       @default(0.00) @db.Decimal(10, 2)
  status        AdvanceStatus @default(PENDING)
  requestDate   DateTime      @default(now())
  approvedDate  DateTime?
  notes         String?       @db.Text
  // legacy
  advanceDate   DateTime?     @db.Date
  reason        String?       @db.VarChar(255)
  paymentMethod String?       @default("CASH") @db.VarChar(50)
  isDeducted    Boolean?      @default(false)
  deductedMonth String?       @db.VarChar(100)
  createdAt     DateTime?     @default(now()) @db.Timestamp(0)
  staffName     String?
  staffRole     String?       @db.VarChar(100)

  staff Staff @relation(fields: [staffId], references: [id])
  hotel Hotel @relation(fields: [hotelId], references: [id])

  @@index([hotelId], map: "idx_adv_hotel")
  @@index([staffId], map: "idx_adv_staff")
  @@index([status], map: "idx_adv_status")
  @@map("staff_advances")
}

// ========================================================
// 8. SALARY PAYMENT (Monthly Payroll Settlements)
// ========================================================

model SalaryPayment {
  id                String         @id @default(cuid())
  staffId           String
  hotelId           String
  month             Int
  year              Int
  baseSalary        Decimal        @db.Decimal(10, 2)
  allowances        Decimal        @default(0.00) @db.Decimal(10, 2)
  deductions        Decimal        @default(0.00) @db.Decimal(10, 2)
  netAmount         Decimal        @db.Decimal(10, 2)
  status            SalaryStatus   @default(PENDING)
  paidAt            DateTime?
  paymentMethod     PaymentMethod?
  reference         String?
  // legacy
  presentDays       Int?           @default(30)
  halfDays          Int?           @default(0)
  absentDays        Int?           @default(0)
  advanceDeductions Decimal?       @default(0.00) @db.Decimal(10, 2)
  staffName         String?
  role              String?        @db.VarChar(100)

  staff Staff @relation(fields: [staffId], references: [id])
  hotel Hotel @relation(fields: [hotelId], references: [id])

  @@unique([staffId, month, year], map: "uq_salary_staff_period")
  @@index([hotelId], map: "idx_sal_hotel")
  @@index([year, month], map: "idx_sal_period")
  @@index([status], map: "idx_sal_status")
  @@map("salary_payments")
}

// ========================================================
// 9. ROOM (Hotel Inventory Units)
// ========================================================

model Room {
  id                 String     @id @default(cuid())
  hotelId            String
  roomNumber         String
  floor              Int
  type               RoomType   @default(STANDARD)
  status             RoomStatus @default(AVAILABLE)
  basePricePerNight  Decimal    @db.Decimal(10, 2)
  maxOccupancy       Int        @default(2)
  bedCount           Int        @default(1)
  hasBalcony         Boolean    @default(false)
  hasOceanView       Boolean    @default(false)
  description        String?    @db.Text
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @default(now()) @updatedAt
  // legacy
  category           String?    @db.VarChar(100)
  defaultPrice       Decimal?   @db.Decimal(10, 2)
  housekeepingStatus String?    @default("clean") @db.VarChar(50)
  capacity           Int?       @default(2)
  ratePerNight       Decimal?   @default(2500.00) @db.Decimal(10, 2)
  currentGuestName   String?
  currentBookingId   String?

  hotel        Hotel         @relation(fields: [hotelId], references: [id])
  bookingRooms BookingRoom[]
  stays        Stay[]

  @@unique([hotelId, roomNumber], map: "uq_rooms_hotel_num")
  @@index([hotelId], map: "idx_rooms_hotel")
  @@index([type], map: "idx_rooms_type")
  @@index([status], map: "idx_rooms_status")
  @@map("rooms")
}

// ========================================================
// 10. GUEST (Customer Identity)
// ========================================================

model Guest {
  id              String   @id @default(cuid())
  organizationId  String
  firstName       String
  lastName        String
  email           String?
  phone           String?
  idType          String?
  idNumber        String?
  nationality     String?
  address         String?
  city            String?
  country         String?
  vipStatus       Boolean  @default(false)
  specialRequests String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  bookings   Booking[]
  stayGuests StayGuest[]

  @@index([organizationId], map: "idx_guests_org")
  @@index([email], map: "idx_guests_email")
  @@index([phone], map: "idx_guests_phone")
  @@index([idNumber], map: "idx_guests_idnum")
  @@map("guests")
}

// ========================================================
// 11. BOOKING (Reservations)
// ========================================================

model Booking {
  id               String        @id @default(cuid())
  hotelId          String
  // Optional in TiDB: legacy bookings store the guest inline (guestName/guestPhone/guestEmail).
  guestId          String?
  createdById      String?
  bookingReference String        @unique(map: "bookingReference")
  status           BookingStatus @default(PENDING)
  checkInDate      DateTime
  checkOutDate     DateTime
  totalGuests      Int           @default(1)
  totalRooms       Int           @default(1)
  totalAmount      Decimal       @db.Decimal(12, 2)
  taxAmount        Decimal       @default(0.00) @db.Decimal(10, 2)
  discountAmount   Decimal       @default(0.00) @db.Decimal(10, 2)
  notes            String?       @db.Text
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @default(now()) @updatedAt
  // legacy (room + event booking fields used by the earlier app)
  bookingType      String?       @default("normal") @db.VarChar(50)
  eventName        String?
  requiredRooms    Int?          @default(0)
  allocatedRooms   Int?          @default(0)
  remainingRooms   Int?          @default(0)
  guestName        String?
  guestPhone       String?       @db.VarChar(50)
  guestEmail       String?
  roomType         String?       @db.VarChar(100)
  roomPrice        Decimal?      @default(0) @db.Decimal(10, 2)
  advanceAmount    Decimal?      @default(0) @db.Decimal(10, 2)
  paymentMethod    String?       @default("UPI") @db.VarChar(50)
  roomId           String?
  roomNumber       String?       @db.VarChar(50)
  roomCategory     String?       @db.VarChar(100)
  depositPaid      Decimal?      @default(0) @db.Decimal(12, 2)
  paymentStatus    String?       @default("paid") @db.VarChar(50)
  nightsCount      Int?          @default(1)

  hotel        Hotel                @relation(fields: [hotelId], references: [id])
  guest        Guest?               @relation(fields: [guestId], references: [id])
  createdBy    User?                @relation("BookedByUser", fields: [createdById], references: [id])
  bookingRooms BookingRoom[]
  extraCharges BookingExtraCharge[]
  stay         Stay?
  invoices     Invoice[]
  payments     Payment[]

  @@index([hotelId], map: "idx_bookings_hotel")
  @@index([guestId], map: "idx_bookings_guest")
  @@index([createdById], map: "idx_bookings_creator")
  @@index([status], map: "idx_bookings_status")
  @@index([checkInDate], map: "idx_bookings_checkin")
  @@index([checkOutDate], map: "idx_bookings_checkout")
  @@map("bookings")
}

// ========================================================
// 12. BOOKING ROOM (Room Allocation in Booking)
// ========================================================

model BookingRoom {
  id          String  @id @default(cuid())
  bookingId   String
  roomId      String
  nightlyRate Decimal @db.Decimal(10, 2)

  booking Booking @relation(fields: [bookingId], references: [id])
  room    Room    @relation(fields: [roomId], references: [id])

  @@unique([bookingId, roomId], map: "uq_booking_room")
  @@index([roomId], map: "idx_bkroom_room")
  @@map("booking_rooms")
}

// ========================================================
// 13. BOOKING EXTRA CHARGE (Amenities & Incidentals)
// ========================================================

model BookingExtraCharge {
  id        String   @id @default(cuid())
  bookingId String
  title     String
  category  String
  amount    Decimal  @db.Decimal(10, 2)
  quantity  Int      @default(1)
  chargedAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([bookingId], map: "idx_extra_booking")
  @@map("booking_extra_charges")
}

// ========================================================
// 14. STAY (Actual Check-in to Check-out Period)
// ========================================================

model Stay {
  id             String     @id @default(cuid())
  hotelId        String
  bookingId      String     @unique(map: "bookingId")
  roomId         String
  status         StayStatus @default(ACTIVE)
  actualCheckIn  DateTime   @default(now())
  actualCheckOut DateTime?
  keyCardCount   Int        @default(1)
  remarks        String?    @db.Text

  hotel      Hotel       @relation(fields: [hotelId], references: [id])
  booking    Booking     @relation(fields: [bookingId], references: [id])
  room       Room        @relation(fields: [roomId], references: [id])
  stayGuests StayGuest[]

  @@index([hotelId], map: "idx_stays_hotel")
  @@index([roomId], map: "idx_stays_room")
  @@index([status], map: "idx_stays_status")
  @@map("stays")
}

// ========================================================
// 15. STAY GUEST (Residents in the Room)
// ========================================================

model StayGuest {
  id             String  @id @default(cuid())
  stayId         String
  guestId        String
  isPrimaryGuest Boolean @default(false)

  stay  Stay  @relation(fields: [stayId], references: [id])
  guest Guest @relation(fields: [guestId], references: [id])

  @@unique([stayId, guestId], map: "uq_stay_guest")
  @@index([guestId], map: "idx_stay_guest_id")
  @@map("stay_guests")
}

// ========================================================
// 16. PAYMENT (Financial Transactions)
// ========================================================

model Payment {
  id                   String        @id @default(cuid())
  hotelId              String
  bookingId            String?
  invoiceId            String?
  processedById        String?
  transactionReference String        @unique(map: "transactionReference")
  amount               Decimal       @db.Decimal(12, 2)
  currency             String        @default("USD")
  paymentMethod        PaymentMethod @default(CASH)
  status               PaymentStatus @default(COMPLETED)
  gatewayResponse      String?       @db.Text
  paidAt               DateTime      @default(now())

  hotel       Hotel    @relation(fields: [hotelId], references: [id])
  booking     Booking? @relation(fields: [bookingId], references: [id])
  invoice     Invoice? @relation(fields: [invoiceId], references: [id])
  processedBy User?    @relation("PaymentProcessedBy", fields: [processedById], references: [id])

  @@index([hotelId], map: "idx_pay_hotel")
  @@index([bookingId], map: "idx_pay_booking")
  @@index([invoiceId], map: "idx_pay_invoice")
  @@index([processedById], map: "idx_pay_user")
  @@index([status], map: "idx_pay_status")
  @@index([paidAt], map: "idx_pay_date")
  @@map("payments")
}

// ========================================================
// 17. INVOICE (Formal Billing Folios)
// ========================================================

model Invoice {
  id             String        @id @default(cuid())
  hotelId        String
  bookingId      String
  invoiceNumber  String        @unique(map: "invoiceNumber")
  subtotal       Decimal       @db.Decimal(12, 2)
  taxAmount      Decimal       @db.Decimal(10, 2)
  discountAmount Decimal       @default(0.00) @db.Decimal(10, 2)
  totalAmount    Decimal       @db.Decimal(12, 2)
  paidAmount     Decimal       @default(0.00) @db.Decimal(12, 2)
  status         InvoiceStatus @default(DRAFT)
  dueDate        DateTime?
  issuedAt       DateTime      @default(now())
  // legacy (itemised billing used by the earlier app)
  guestName      String?
  roomNumber     String?       @db.VarChar(50)
  itemsJson      Json?
  balanceDue     Decimal?      @default(0.00) @db.Decimal(10, 2)
  settledAt      String?       @db.VarChar(100)
  paymentMethod  String?       @db.VarChar(50)

  hotel    Hotel     @relation(fields: [hotelId], references: [id])
  booking  Booking   @relation(fields: [bookingId], references: [id])
  payments Payment[]

  @@index([hotelId], map: "idx_inv_hotel")
  @@index([bookingId], map: "idx_inv_booking")
  @@index([status], map: "idx_inv_status")
  @@map("invoices")
}

// ========================================================
// 18. EXPENSE (Operational Expenditures)
// ========================================================

model Expense {
  id            String          @id @default(cuid())
  hotelId       String
  category      ExpenseCategory @default(SUPPLIES)
  title         String
  amount        Decimal         @db.Decimal(12, 2)
  paymentMethod PaymentMethod   @default(CASH)
  reference     String?
  receiptUrl    String?
  incurredAt    DateTime
  createdAt     DateTime        @default(now())
  // legacy (spec §8: description / "Added By")
  expenseDate   DateTime?       @db.Date
  paidTo        String?
  description   String?         @db.Text
  vendor        String?
  recordedBy    String?         @default("Manager")

  hotel Hotel @relation(fields: [hotelId], references: [id])

  @@index([hotelId], map: "idx_exp_hotel")
  @@index([category], map: "idx_exp_category")
  @@index([incurredAt], map: "idx_exp_date")
  @@map("expenses")
}

// ========================================================
// 19. AUDIT LOG (Immutable Regulatory Compliance)
// ========================================================

model AuditLog {
  id         String      @id @default(cuid())
  hotelId    String?
  userId     String?
  action     AuditAction
  entityType String
  entityId   String
  ipAddress  String?
  userAgent  String?
  details    String?     @db.Text
  createdAt  DateTime    @default(now())

  hotel Hotel? @relation(fields: [hotelId], references: [id])
  user  User?  @relation(fields: [userId], references: [id])

  @@index([hotelId], map: "idx_audit_hotel")
  @@index([userId], map: "idx_audit_user")
  @@index([action], map: "idx_audit_action")
  @@index([entityType], map: "idx_audit_entity")
  @@index([createdAt], map: "idx_audit_created")
  @@map("audit_logs")
}

// ========================================================
// LEGACY MODULE TABLES (created by an earlier app version; hold data)
// Modelled as-is so they are never dropped. Not used by the API yet.
// ========================================================

model BanquetEvent {
  id           String              @id @default(cuid())
  hotelId      String
  eventName    String
  eventType    String              @db.VarChar(100)
  clientName   String
  clientPhone  String              @db.VarChar(50)
  venueName    String
  eventDate    DateTime            @db.Date
  guestCount   Int
  perPlateRate Decimal             @db.Decimal(10, 2)
  cateringType String              @db.VarChar(100)
  totalAmount  Decimal             @db.Decimal(12, 2)
  depositPaid  Decimal             @db.Decimal(12, 2)
  status       BanquetEventStatus? @default(confirmed)
  decorPackage String?             @db.Text
  createdAt    DateTime?           @default(now()) @db.Timestamp(0)

  @@map("banquet_events")
}

model ConciergeBooking {
  id                    String                  @id @default(cuid())
  hotelId               String
  bookingRef            String                  @unique(map: "bookingRef") @db.VarChar(50)
  roomNumber            String                  @db.VarChar(20)
  guestName             String
  serviceTitle          String
  category              String                  @db.VarChar(100)
  driverOrGuideName     String
  vehicleOrVesselNumber String                  @db.VarChar(100)
  pickupTime            String                  @db.VarChar(50)
  date                  DateTime                @db.Date
  numberOfGuests        Int
  totalAmount           Decimal                 @db.Decimal(10, 2)
  gstAmount             Decimal                 @db.Decimal(10, 2)
  status                ConciergeBookingStatus? @default(scheduled)
  notes                 String?                 @db.Text
  createdAt             DateTime?               @default(now()) @db.Timestamp(0)

  @@map("concierge_bookings")
}

model DiningOrder {
  id          String             @id @default(cuid())
  hotelId     String
  orderNumber String             @unique(map: "orderNumber") @db.VarChar(50)
  roomNumber  String             @db.VarChar(20)
  guestName   String
  itemsJson   Json
  subtotal    Decimal            @db.Decimal(10, 2)
  gstAmount   Decimal            @db.Decimal(10, 2)
  totalAmount Decimal            @db.Decimal(10, 2)
  status      DiningOrderStatus? @default(received)
  dietaryNote String?            @db.Text
  createdAt   String             @db.VarChar(50)

  @@map("dining_orders")
}

model ExcursionPackage {
  id                 String  @id @default(cuid())
  title              String
  duration           String  @db.VarChar(50)
  pricePerPerson     Decimal @db.Decimal(10, 2)
  category           String  @db.VarChar(100)
  description        String? @db.Text
  includedHighlights Json?

  @@map("excursion_packages")
}

model HousekeepingTicket {
  id                String                    @id @default(cuid())
  hotelId           String
  roomNumber        String                    @db.VarChar(20)
  ticketType        String                    @db.VarChar(100)
  priority          HousekeepingPriority?     @default(normal)
  assignedStaffName String
  status            HousekeepingTicketStatus? @default(pending)
  requestedTime     String                    @db.VarChar(50)
  notes             String?                   @db.Text
  createdAt         DateTime?                 @default(now()) @db.Timestamp(0)

  @@map("housekeeping_tickets")
}

model ShiftHandover {
  id                        String    @id @default(cuid())
  hotelId                   String
  outgoingManagerName       String
  incomingManagerName       String
  shiftFrom                 String    @db.VarChar(50)
  shiftTo                   String    @db.VarChar(50)
  timestamp                 String    @db.VarChar(100)
  frontDeskCashCollected    Decimal   @db.Decimal(10, 2)
  upiSettlementsCount       Int
  upiSettlementsAmount      Decimal   @db.Decimal(12, 2)
  pendingGuestRequestsCount Int
  vipGuestsInHouse          Json?
  keyHandoversNotes         String?   @db.Text
  status                    String?   @default("completed") @db.VarChar(50)
  createdAt                 DateTime? @default(now()) @db.Timestamp(0)

  @@map("shift_handovers")
}

model SpaBooking {
  id            String            @id @default(cuid())
  hotelId       String
  bookingRef    String            @unique(map: "bookingRef") @db.VarChar(50)
  roomNumber    String            @db.VarChar(20)
  guestName     String
  treatmentName String
  therapistName String
  treatmentRoom String            @db.VarChar(100)
  timeSlot      String            @db.VarChar(50)
  date          DateTime          @db.Date
  price         Decimal           @db.Decimal(10, 2)
  gstAmount     Decimal           @db.Decimal(10, 2)
  totalAmount   Decimal           @db.Decimal(10, 2)
  status        SpaBookingStatus? @default(scheduled)
  healthNotes   String?           @db.Text
  createdAt     DateTime?         @default(now()) @db.Timestamp(0)

  @@map("spa_bookings")
}

model SpaTreatment {
  id                String  @id @default(cuid())
  name              String
  durationMinutes   Int
  price             Decimal @db.Decimal(10, 2)
  category          String  @db.VarChar(100)
  description       String? @db.Text
  herbalIngredients String? @db.Text

  @@map("spa_treatments")
}
