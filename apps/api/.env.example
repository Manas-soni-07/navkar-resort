# ========================================================
# ResortOS API - Environment Variables Template
# Copy to apps/api/.env.local for local backend execution
# NEVER put real production secrets into this file!
# ========================================================

# Server Configuration
PORT=3000
NODE_ENV=development

# Database (TiDB Cloud Serverless / MySQL compatibility)
# Format: mysql://<USER>:<PASSWORD>@<HOST>:4000/<DATABASE>?sslaccept=strict
DATABASE_URL="mysql://root:password@127.0.0.1:4000/resortos_dev?sslaccept=strict"

# Authentication Secrets (Placeholder for Phase 2)
JWT_SECRET="replace-with-a-secure-random-64-character-string"
JWT_EXPIRES_IN="7d"

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS="http://localhost:3000,http://localhost:8081"
